        {
          "type": "text",
          "title": "Oefening",
          "text": "Speel alleen de zwarte A-noten, van laag naar hoog en terug.\n<i>Doel</i>: Altijd weten waar je veilig kunt landen in A mineur.",
          "width": "narrow"
        },
